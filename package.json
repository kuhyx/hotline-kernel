{
  "name": "hotline-kernel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One-hit-kill FPS combat kernel: commit-token pressure, hybrid line-of-sight, tunable wind-ups.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "knip": "knip",
    "jscpd": "jscpd src",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm jscpd && pnpm build",
    "soak": "vite-node scripts/soak.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@kuhyx/ts-config": "github:kuhyx/utils#ts_config-v0.1.2&path:/ts_config",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "happy-dom": "20.14.5",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-node": "6.0.0",
    "vitest": "5.0.3"
  }
}
